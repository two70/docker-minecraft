# Copy to .env and fill in for each server
# (On Coolify, set these in the resource's Environment Variables instead)

# Host ports
SERVER_PORT=25565
VOICE_PORT=24454

TZ=America/Denver
EULA=TRUE

# Server type: AUTO_CURSEFORGE, or VANILLA, PAPER, FORGE, NEOFORGE, FABRIC, ...
TYPE=AUTO_CURSEFORGE

# For TYPE=AUTO_CURSEFORGE: the pack sets the Minecraft and loader versions.
# API key from https://console.curseforge.com/
CF_API_KEY=
# Slug from the pack URL: curseforge.com/minecraft/modpacks/<slug>
CF_SLUG=
# File ID of the pack version, so the server matches the client exactly
CF_FILE_ID=

# For other types only
VERSION=LATEST
NEOFORGE_VERSION=LATEST

MEMORY=4G
MAX_MEMORY=6G
DEBUG=false

MAX_PLAYERS=10
PVP=false
MOTD="A Minecraft Server"
GAMEMODE=survival
DIFFICULTY=normal

# Comma-separated player UUIDs or usernames
OPS=
WHITELIST=
