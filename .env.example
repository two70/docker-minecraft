# Copy to .env and fill in for each server

# Host ports
SERVER_PORT=25565
VOICE_PORT=24454

# Host directory for server data
DATA_DIR=./server_data

TZ=America/Denver
EULA=TRUE

# Server type and version (VANILLA, PAPER, FORGE, NEOFORGE, FABRIC, ...)
TYPE=VANILLA
VERSION=LATEST

MEMORY=4G
MAX_MEMORY=6G
DEBUG=false

MAX_PLAYERS=10
PVP=false
MOTD="A Minecraft Server"
GAMEMODE=survival
DIFFICULTY=normal

# Comma-separated player UUIDs or usernames
OPS=
WHITELIST=
